{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/forms/**",
              "components/motion/**",
              "components/primitives/**",
              "components/surfaces/**",
              "guidelines/**",
              "ui_kits/conformance/**",
              "ui_kits/glass-lab/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|Open Sans))/i]",
        "message": "Font not provided by the design system. Available: Outfit, Open Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackdropStage'] > JSXAttribute > JSXIdentifier[name!=/^(?:mood|mode|luma|density|tier|image|height|radius|children|key|ref|className|style|children)$/]",
        "message": "<BackdropStage> doesn't accept that prop. Declared props: mood, mode, luma, density, tier, image, height, radius, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackdropStage'] > JSXAttribute[name.name='mood'] > Literal[value!=/^(?:warm|cool|busy|plain)$/]",
        "message": "<BackdropStage> mood must be one of 'warm' | 'cool' | 'busy' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackdropStage'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<BackdropStage> mode must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackdropStage'] > JSXAttribute[name.name='luma'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<BackdropStage> luma must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onChange|readOnly|label|description|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, defaultChecked, onChange, readOnly, label, description, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Choreography'] > JSXAttribute > JSXIdentifier[name!=/^(?:parallax|stagger|rootMargin|as|children|key|ref|className|style|children)$/]",
        "message": "<Choreography> doesn't accept that prop. Declared props: parallax, stagger, rootMargin, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentPlane'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|as|children|key|ref|className|style|children)$/]",
        "message": "<ContentPlane> doesn't accept that prop. Declared props: padding, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|error|required|htmlFor|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, description, error, required, htmlFor, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|fill|emphasis|tone|disabled|children|key|ref|className|style|children)$/]",
        "message": "<GlassButton> doesn't accept that prop. Declared props: size, fill, emphasis, tone, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<GlassButton> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|body|meta|fill|scrim|spec|children|key|ref|className|style|children)$/]",
        "message": "<GlassCard> doesn't accept that prop. Declared props: eyebrow, title, body, meta, fill, scrim, spec, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|actions|fill|open|onClose|scrimOpacity|children|key|ref|className|style|children)$/]",
        "message": "<GlassModal> doesn't accept that prop. Declared props: title, body, actions, fill, open, onClose, scrimOpacity, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|items|active|onSelect|fill|trailing|key|ref|className|style|children)$/]",
        "message": "<GlassNav> doesn't accept that prop. Declared props: brand, items, active, onSelect, fill, trailing."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassSearch'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|onSubmit|open|width|fill|key|ref|className|style|children)$/]",
        "message": "<GlassSearch> doesn't accept that prop. Declared props: placeholder, value, onChange, onSubmit, open, width, fill."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassSegmented'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|size|fill|key|ref|className|style|children)$/]",
        "message": "<GlassSegmented> doesn't accept that prop. Declared props: items, value, onChange, size, fill."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassSegmented'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<GlassSegmented> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassSurface'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|fill|emphasis|tone|refract|interactive|scrim|as|children|key|ref|className|style|children)$/]",
        "message": "<GlassSurface> doesn't accept that prop. Declared props: level, fill, emphasis, tone, refract, interactive, scrim, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|label|children|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: size, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Icon> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveBackdrop'] > JSXAttribute > JSXIdentifier[name!=/^(?:effect|mood|density|speed|interactive|showDots|mode|luma|stageDensity|tier|height|radius|children|key|ref|className|style|children)$/]",
        "message": "<LiveBackdrop> doesn't accept that prop. Declared props: effect, mood, density, speed, interactive, showDots, mode, luma, stageDensity, tier, height, radius, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveBackdrop'] > JSXAttribute[name.name='density'] > Literal[value!=/^(?:low|medium|high)$/]",
        "message": "<LiveBackdrop> density must be one of 'low' | 'medium' | 'high'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveBackdrop'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<LiveBackdrop> mode must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveBackdrop'] > JSXAttribute[name.name='luma'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<LiveBackdrop> luma must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|options|placeholder|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: invalid, options, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:blur|opacity|override|key|ref|className|style|children)$/]",
        "message": "<SpecChip> doesn't accept that prop. Declared props: blur, opacity, override."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stack'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|gap|align|justify|wrap|inline|padding|as|children|key|ref|className|style|children)$/]",
        "message": "<Stack> doesn't accept that prop. Declared props: direction, gap, align, justify, wrap, inline, padding, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stack'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:row|column)$/]",
        "message": "<Stack> direction must be one of 'row' | 'column'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|tone|weight|align|as|plane|numeric|mono|children|key|ref|className|style|children)$/]",
        "message": "<Text> doesn't accept that prop. Declared props: role, tone, weight, align, as, plane, numeric, mono, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Text> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|rows|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: invalid, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='VisuallyHidden'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|children|key|ref|className|style|children)$/]",
        "message": "<VisuallyHidden> doesn't accept that prop. Declared props: as, children."
      }
    ]
  },
